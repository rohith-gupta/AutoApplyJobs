# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env is gitignored - never commit real secrets. The values below are safe
# placeholders for local development only.

POSTGRES_DB=autoapplyjobs
POSTGRES_USER=autoapplyjobs
POSTGRES_PASSWORD=changeme_local_only

# Host port PostgreSQL is exposed on. Defaults to 5432 in docker-compose.yml,
# but that port is commonly already taken by a local PostgreSQL install. If
# `docker compose up` fails to bind, or you already have Postgres running on
# your machine, set this to 5433 (or another free port) instead.
POSTGRES_PORT=5432
